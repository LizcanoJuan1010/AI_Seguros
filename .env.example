# === SegurIA API ===
MANAGER_API_KEY=demo-gerente-2026
# Key de servicio para endpoints internos del agente (roles, leads, conversaciones)
SERVICE_API_KEY=demo-service-2026
# Números de WhatsApp con rol gerente, separados por coma (formato +57...)
MANAGER_PHONES=
# CORS: orígenes cruzados permitidos (coma-separados). Vacío = solo same-origin.
CORS_ORIGINS=

# Marca de los documentos
BRAND_NAME=Tequendama
BRAND_TAGLINE=Protección inteligente inspirada en la naturaleza
BRAND_COLOR=#083911

# === Estudio de banners de marketing (correo/Instagram/LinkedIn) ===
# Sin GEMINI_API_KEY el endpoint POST /api/marketing/banner corre en modo demo
# (no genera nada). Key de https://aistudio.google.com/apikey. La paleta de
# color (Colsubsidio, no Tequendama) es fija en config.py, no viene del .env.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# === Metabase (opcional) ===
METABASE_URL=
METABASE_API_KEY=

# === LLM (Hermes y orquestador web /api/chat) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Alternativas: OPENROUTER_API_KEY / ANTHROPIC_API_KEY

# === Agente Hermes (WhatsApp) ===
# idle = contenedor vivo solo para configurar · gateway = WhatsApp activo
HERMES_MODE=idle

# === Pagos — Polar SANDBOX (https://sandbox.polar.sh → Settings → Developers) ===
# Sin POLAR_ACCESS_TOKEN el flujo de pago del asistente corre en modo demo/simulado.
# Usa SIEMPRE el entorno sandbox (token de organización creado en sandbox.polar.sh);
# los pagos de prueba se hacen con las tarjetas de test de Stripe (4242 4242 4242 4242).
POLAR_BASE_URL=https://sandbox-api.polar.sh/v1
POLAR_ACCESS_TOKEN=
# Secreto del webhook (Settings → Webhooks, formato "Raw"): firma de
# POST /api/v1/payments/webhook (backend)
POLAR_WEBHOOK_SECRET=
# URL a la que Polar redirige al cliente tras pagar (opcional)
POLAR_SUCCESS_URL=

# === Auth / JWT (login + tenencia desde el login) ===
# La MISMA clave la comparten backend (emite) y servicio IA (verifica).
JWT_SECRET=demo-secret-seguria-2026
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
# Usuarios demo sembrados: gerente@colsubsidio.demo / agente@colsubsidio.demo /
# gerente@tenantb.demo  (contraseña: demo123)

# === ElevenLabs (canal de llamadas telefónicas) ===
# Dos webhooks, dos secretos DISTINTOS (nunca el mismo valor en ambos):
#
# ELEVENLABS_WEBHOOK_SECRET: header simple (X-Webhook-Secret) que ElevenLabs
# manda tal cual al llamar POST /api/v1/elevenlabs/init (inicio de llamada,
# hoy: llamadas entrantes de Twilio — "Twilio personalization" en su doc).
# El nombre del header y el valor los defines TÚ en el dashboard de
# ElevenLabs; deben coincidir exacto con esto.
ELEVENLABS_WEBHOOK_SECRET=demo-elevenlabs-secret-2026
#
# ELEVENLABS_POSTCALL_SECRET: secreto de la firma HMAC-SHA256 del webhook
# post-call (POST /api/v1/elevenlabs/webhook, header ElevenLabs-Signature).
# Se configura al crear ESE webhook en el dashboard (Settings -> Webhooks).
ELEVENLABS_POSTCALL_SECRET=demo-elevenlabs-postcall-secret-2026
# Motor de llamadas salientes (POST /api/calls/outbound, servicio IA). Sin
# ELEVENLABS_API_KEY corre en modo demo (no llama a nadie). agent_id y
# agent_phone_number_id salen del dashboard de ElevenLabs (Agents Platform).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Voz específica (voice_id del dashboard). Vacío = voz por defecto del agente.
ELEVENLABS_VOICE_ID=

# === Canal WhatsApp (gateway Baileys multi-tenant reusado, no propio) ===
# Tequendama es un TENANT NUEVO en un wa-gateway ya desplegado (de otro
# proyecto). WA_GATEWAY_WEBHOOK_SECRET debe ser IGUAL al WEBHOOK_SECRET
# configurado allá — sin él, el receptor entrante rechaza todo con 401.
# Vacío = el canal corre en modo demo (no envía ni recibe WhatsApp real).
WA_GATEWAY_URL=
WA_GATEWAY_WEBHOOK_SECRET=
WA_GATEWAY_TENANT=tequendama
# Número ya emparejado que el chat WEB le ofrece al cliente para seguir por
# WhatsApp sin insistir (ver agent_core.WEB_HANDOFF_SUFFIX). Solo texto, ej:
WHATSAPP_BUSINESS_NUMBER=

# === URL pública de este servicio (seguria-ai) ===
# Para armar links que el cliente pueda abrir de verdad fuera de la red
# interna: descarga de documentos por WhatsApp y el link de firma electrónica
# (ver apps/ai/app/esign.py). Vacío = esos links quedan como ruta relativa
# (no funcionan si se abren fuera de la SPA). Ej: https://api.tequendama.com
PUBLIC_BASE_URL=
# Minutos de vigencia del link de firma electrónica (clickwrap) antes de expirar.
ESIGN_LINK_TTL_MINUTES=60

# === KYC — Didit (verification.didit.me) ===
# Verificación de identidad (cédula + selfie con liveness/face-match) vía link
# de cámara en vivo (nunca fotos reenviadas del chat). Sin DIDIT_API_KEY corre
# en modo demo: aprueba con datos simulados, para probar el flujo completo.
DIDIT_API_KEY=
DIDIT_BASE_URL=https://verification.didit.me
# Umbrales 0-100 (docs.didit.me): por debajo, el caso pasa a revisión manual.
DIDIT_LIVENESS_MIN_SCORE=70
DIDIT_FACE_MATCH_MIN_SCORE=70
KYC_LINK_TTL_MINUTES=60

# === Motor de versionado/QA de prompts (docket, adaptado de docket-motor) ===
# Versiona y mejora SYSTEM_PROMPT_CLIENTE/GERENTE con datos reales (schema
# `docket` en la misma base). Sin monitoreo en vivo (esa pieza es
# enterprise-only en ElevenLabs, no se implementó). Vacío/false = el proyecto
# sigue leyendo los prompts hardcodeados de agent_core.py, igual que siempre.
DOCKET_ENGINE_ENABLED=false

# === Agente de voz saliente (Deepgram + Twilio, profile "voice-outbound") ===
# DEEPGRAM_API_KEY/STT_MODEL/STT_LANGUAGE/VOICE_MODEL se reusan en DOS sitios:
# 1) apps/services/deepgram-outbound (servicio separado, llamadas de voz) —
#    ver docs/LOCAL_DEVELOPMENT.md ahí y su propio .env.example.
# 2) seguria-ai (apps/ai/app/voice_deepgram.py): tools STT/TTS para notas de
#    voz (POST /api/voice/transcribe, /api/voice/generar) que Hermes puede
#    invocar — no es el motor de llamadas, es audio de chat/WhatsApp.
# NUNCA pegues las keys reales acá ni en el chat.
DEEPGRAM_API_KEY=
# URL pública del túnel (ngrok) — cambia cada vez que reinicias ngrok.
DEEPGRAM_SERVER_EXTERNAL_URL=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=es
DEEPGRAM_LLM_MODEL=gpt-4o-mini
DEEPGRAM_LLM_PROVIDER=open_ai
DEEPGRAM_VOICE_MODEL=aura-2-celeste-es
# Twilio: TWILIO_PHONE_NUMBER es tu Verified Caller ID (+573203199867), NO un
# número comprado — Twilio acepta un Verified Caller ID como "from".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_ENDPOINT_SECRET=

# === Perfilamiento post-llamada (backend -> servicio IA) ===
# El backend llama a esta URL tras cada llamada de ElevenLabs para extraer el
# perfil del cliente por LLM (ver apps/ai/app/call_profiling.py). Usa la MISMA
# SERVICE_API_KEY de arriba para autenticarse (X-Service-Key).
AI_SERVICE_URL=http://seguria-ai:8085

# === Seguro embebido (quote & bind para aliados B2B2C) ===
# API keys de partners separadas por coma; cada aliado integra /api/embedded/*
# en su checkout (o el iframe /embed del frontend).
PARTNER_API_KEYS=demo-partner-2026

# === Voz en el chat web (perfil docker "voz") ===
# El endpoint /api/assistant/tts proxya al Kokoro-FastAPI local; sin el perfil
# encendido el toggle de voz del chat simplemente no suena.
TTS_URL=http://seguria-tts:8880
TTS_VOICE=ef_dora

# ── TWILIO ────────────────────────────────────────
# Dónde: console.twilio.com → página principal (Account Dashboard)
# Sección "Account Info", abajo a la izquierda del dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu caller ID verificado (este sí es público, va tal cual):
TWILIO_FROM_NUMBER=+573203199867

# ── DEEPGRAM ──────────────────────────────────────
# Dónde: console.deepgram.com → API Keys → "Create a New API Key"
# (dale permisos de Member/Owner; cópiala al crearla porque solo se muestra una vez)
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPENAI (solo si el README del repo lo pide para el LLM) ──
# Dónde: platform.openai.com → API Keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx