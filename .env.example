# === SegurIA API ===
MANAGER_API_KEY=demo-gerente-2026
# Key de servicio para endpoints internos del agente (roles, leads, conversaciones)
SERVICE_API_KEY=demo-service-2026
# Números de WhatsApp con rol gerente, separados por coma (formato +57...)
MANAGER_PHONES=
# CORS: orígenes cruzados permitidos (coma-separados). Vacío = solo same-origin.
CORS_ORIGINS=

# Marca de los documentos
BRAND_NAME=Tequendama
BRAND_TAGLINE=Protección inteligente inspirada en la naturaleza
BRAND_COLOR=#083911

# === Metabase (opcional) ===
METABASE_URL=
METABASE_API_KEY=

# === LLM (Hermes y orquestador web /api/chat) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Alternativas: OPENROUTER_API_KEY / ANTHROPIC_API_KEY

# === Pagos — Wompi SANDBOX (https://comercios.wompi.co, sección Desarrolladores) ===
# Sin WOMPI_PRIVATE_KEY el flujo de pago del asistente corre en modo demo/simulado.
# Usa SIEMPRE llaves de prueba (prv_test_... / test_events_...), nunca de producción.
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PRIVATE_KEY=
# Secreto de eventos: firma el webhook POST /api/v1/payments/webhook (backend)
WOMPI_EVENTS_SECRET=
# URL a la que Wompi redirige al cliente tras pagar (opcional)
WOMPI_REDIRECT_URL=

# === Auth / JWT (login + tenencia desde el login) ===
# La MISMA clave la comparten backend (emite) y servicio IA (verifica).
JWT_SECRET=demo-secret-seguria-2026
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
# Usuarios demo sembrados: gerente@colsubsidio.demo / agente@colsubsidio.demo /
# gerente@tenantb.demo  (contraseña: demo123)

# === ElevenLabs (canal de llamadas telefónicas) ===
# Secreto compartido para verificar la firma HMAC del webhook post-call
# (POST /api/v1/elevenlabs/webhook). Debe coincidir con el configurado en
# el dashboard de ElevenLabs al crear el webhook.
ELEVENLABS_WEBHOOK_SECRET=demo-elevenlabs-secret-2026
