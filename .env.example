# === SegurIA API ===
MANAGER_API_KEY=demo-gerente-2026
# Key de servicio para endpoints internos del agente (roles, leads, conversaciones)
SERVICE_API_KEY=demo-service-2026
# Números de WhatsApp con rol gerente, separados por coma (formato +57...)
MANAGER_PHONES=
# CORS: orígenes cruzados permitidos (coma-separados). Vacío = solo same-origin.
CORS_ORIGINS=

# Marca de los documentos
BRAND_NAME=Tequendama
BRAND_TAGLINE=Protección inteligente inspirada en la naturaleza
BRAND_COLOR=#083911

# === Metabase (opcional) ===
METABASE_URL=
METABASE_API_KEY=

# === LLM (Hermes y orquestador web /api/chat) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Alternativas: OPENROUTER_API_KEY / ANTHROPIC_API_KEY

# === Pagos — Polar SANDBOX (https://sandbox.polar.sh → Settings → Developers) ===
# Sin POLAR_ACCESS_TOKEN el flujo de pago del asistente corre en modo demo/simulado.
# Usa SIEMPRE el entorno sandbox (token de organización creado en sandbox.polar.sh);
# los pagos de prueba se hacen con las tarjetas de test de Stripe (4242 4242 4242 4242).
POLAR_BASE_URL=https://sandbox-api.polar.sh/v1
POLAR_ACCESS_TOKEN=
# Secreto del webhook (Settings → Webhooks, formato "Raw"): firma de
# POST /api/v1/payments/webhook (backend)
POLAR_WEBHOOK_SECRET=
# URL a la que Polar redirige al cliente tras pagar (opcional)
POLAR_SUCCESS_URL=

# === Auth / JWT (login + tenencia desde el login) ===
# La MISMA clave la comparten backend (emite) y servicio IA (verifica).
JWT_SECRET=demo-secret-seguria-2026
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
# Usuarios demo sembrados: gerente@colsubsidio.demo / agente@colsubsidio.demo /
# gerente@tenantb.demo  (contraseña: demo123)
