# ──────────────────────────────────────────────────────────────
# Agente de voz saliente (Deepgram + Twilio) — adaptado para
# Tequendama Seguros (seguro de vehículo, español colombiano).
# ──────────────────────────────────────────────────────────────
# Copia este archivo a .env y llena tus valores:
#   cp .env.example .env
#
# NUNCA pegues valores reales aquí ni en el chat — solo en tu .env local
# (gitignored). DEEPGRAM_API_KEY es obligatoria. Twilio + un proveedor de
# LLM (OpenAI/Anthropic/Google) son obligatorios para llamar de verdad.
# Ver docs/LOCAL_DEVELOPMENT.md para la guía completa.
# ──────────────────────────────────────────────────────────────

# Obligatoria - crea una key gratis en https://console.deepgram.com
DEEPGRAM_API_KEY=

# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080

# URL pública donde Twilio puede alcanzar este servidor (Twilio abre un
# WebSocket de vuelta para el audio). Con ngrok: `ngrok http 8080` y copia
# la URL https que te da (cambia cada vez que reinicias ngrok).
# SERVER_EXTERNAL_URL=https://xxxx.ngrok.io

# --- Modelo del agente ---
# STT (listen) — nova-3 (v1), NO Flux (v2, solo inglés). language=es o multi.
# STT_MODEL=nova-3
# STT_LANGUAGE=es
#
# LLM (think) — requiere una key propia del proveedor elegido (ver abajo).
# Deepgram no ofrece un LLM gestionado sin key externa en este SDK.
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=open_ai
#
# TTS (speak) — voces Aura-2 en español con acento colombiano:
# aura-2-celeste-es (femenina, enérgica), aura-2-selena-es, aura-2-diana-es,
# aura-2-javier-es (masculina). Si ajustas `speed` en el código, mantenlo
# entre 0.9 y 1.5 (por debajo de 0.9 el español mete disfluencias).
# VOICE_MODEL=aura-2-celeste-es
# TTS_PROVIDER=deepgram

# --- Key del proveedor de LLM ---
# IMPORTANTE: el settings message de la Voice Agent API (ver
# voice_agent/agent_config.py) NO tiene un campo `api_key` — este código NO
# lee ni reenvía ninguna key de OpenAI/Anthropic/Google. La key del proveedor
# LLM se configura del lado de Deepgram: console.deepgram.com -> tu proyecto
# -> Voice Agent -> "Bring your own key" (LLM providers). Sin eso configurado
# ahí, la llamada fallará con un error de autenticación del LLM aunque
# DEEPGRAM_API_KEY sea válida.

# --- Twilio (obligatorio para llamar de verdad) ---
# TWILIO_PHONE_NUMBER es el "from" — acá va tu Verified Caller ID
# (+573203199867), NO un número comprado. Twilio acepta oficialmente un
# Verified Caller ID como `from` en el REST API; no hace falta comprar nada.
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_PHONE_NUMBER=+573203199867

# --- Seguridad ---
# Secreto para autenticar POST /make-call. Opcional en dev local (sin esto,
# el endpoint acepta cualquier request).
# ENDPOINT_SECRET=
