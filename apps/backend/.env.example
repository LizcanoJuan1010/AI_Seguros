# Copia este archivo como .env y ajusta los valores.
#
# En docker-compose, el host es "postgres" (nombre del servicio).
# Para desarrollo local fuera de Docker, usa localhost y el puerto que expongas.
DATABASE_URL=postgresql://seguria:seguria@localhost:5432/seguria?schema=public
# DIRECT_URL solo hace falta con poolers (p.ej. Supabase). Si no aplica, iguala DATABASE_URL.
DIRECT_URL=postgresql://seguria:seguria@localhost:5432/seguria?schema=public
PORT=3000

# Auth JWT (misma JWT_SECRET que el servicio IA / .env de la raíz)
JWT_SECRET=demo-secret-seguria-2026
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

# Dos webhooks de ElevenLabs, dos secretos DISTINTOS:
# ELEVENLABS_WEBHOOK_SECRET: header simple (X-Webhook-Secret) de
#   POST /api/v1/elevenlabs/init (inicio de llamada). Nombre/valor del
#   header se definen en el dashboard de ElevenLabs.
# ELEVENLABS_POSTCALL_SECRET: firma HMAC-SHA256 (header ElevenLabs-Signature)
#   de POST /api/v1/elevenlabs/webhook (post-call).
ELEVENLABS_WEBHOOK_SECRET=demo-elevenlabs-secret-2026
ELEVENLABS_POSTCALL_SECRET=demo-elevenlabs-postcall-secret-2026

# Perfilamiento post-llamada: el backend llama al servicio IA tras cada
# llamada de ElevenLabs. Fuera de Docker el servicio IA corre en localhost.
AI_SERVICE_URL=http://localhost:8085
SERVICE_API_KEY=demo-service-2026

# === Pagos — Polar SANDBOX (Nest es el ÚNICO dueño de Polar) ===
# Dashboard: https://sandbox.polar.sh → Settings → Developers / Webhooks.
# Sin POLAR_ACCESS_TOKEN el checkout corre en modo demo (sin HTTP a Polar).
# El servicio AI NO lee estas variables: solo llama a
# POST /api/v1/payments/checkout en este backend.
POLAR_BASE_URL=https://sandbox-api.polar.sh/v1
# Organization Access Token (polar_oat_...) del entorno sandbox.
POLAR_ACCESS_TOKEN=
# Secreto del webhook (formato Raw / Standard Webhooks). Firma
# POST /api/v1/payments/webhook. Obligatorio si hay POLAR_ACCESS_TOKEN;
# sin secreto + con token → 401 (fail-closed).
POLAR_WEBHOOK_SECRET=
# URL a la que Polar redirige al cliente tras pagar (opcional).
# Local: http://localhost:5173/llamada  o  http://localhost:5173/
POLAR_SUCCESS_URL=
