# Servicio systemd para la API SegurIA.
# Instala:  sudo cp deploy/seguria-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now seguria-api
# Ajusta User, WorkingDirectory y EnvironmentFile a tu máquina.
[Unit]
Description=SegurIA API (asistente de seguros LATAM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=juan
WorkingDirectory=/home/juan/dev/HackathonColsupcidio/apps/ai
EnvironmentFile=/home/juan/dev/HackathonColsupcidio/.env
ExecStart=/home/juan/dev/HackathonColsupcidio/apps/ai/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8085
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
