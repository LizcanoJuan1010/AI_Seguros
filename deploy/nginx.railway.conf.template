# nginx del frontend en Railway: sirve la SPA y enruta las APIs a los otros
# dos servicios de Railway por red privada. A diferencia de docker-compose
# (deploy/nginx.conf, DNS estable de Docker), las IPs internas de Railway
# CAMBIAN en cada redeploy de backend/ai — sin el `resolver` + variable en
# `proxy_pass` de abajo, nginx cachea la IP vieja al arrancar y empieza a
# devolver 502 apenas el otro servicio se redespliega (confirmado contra la
# doc de Railway, jul 2026 — ellos mismos recomiendan Caddy por esto; esto
# es el workaround documentado para seguir con nginx sin sumar otra
# herramienta al stack).
#
# Variables sustituidas por `envsubst` (mecanismo nativo de la imagen
# `nginx:alpine` para archivos `*.template` en /etc/nginx/templates/ — ver
# deploy/frontend.railway.Dockerfile):
#   PORT                 — puerto que Railway le asigna a ESTE servicio
#   BACKEND_INTERNAL_URL — ej. http://backend.railway.internal:3000
#   AI_INTERNAL_URL      — ej. http://ai.railway.internal:8085

resolver [fd12::10] ipv6=on valid=1s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Subida de documentos al chat (el default de 1m rechaza con 413
    # cualquier PDF/foto real; el front limita a 10 MB por archivo).
    client_max_body_size 15m;

    # SPA: cualquier ruta desconocida cae en index.html (React Router).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Dominio (NestJS). Incluye el gateway WS de la llamada en vivo
    # (/api/v1/live-call) — sin Upgrade/Connection el handshake no llega.
    location /api/v1/ {
        set $backend_upstream "${BACKEND_INTERNAL_URL}";
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Servicio IA (Python). Incluye el chat por SSE. El WS de la llamada en
    # vivo NO pasa por acá — el navegador lo abre contra /api/v1/live-call
    # (Nest), que a su vez abre su propia conexión saliente al servicio IA;
    # por eso este bloque no necesita Upgrade/Connection (igual que el
    # nginx.conf de docker-compose).
    location /api/ {
        set $ai_upstream "${AI_INTERNAL_URL}";
        proxy_pass $ai_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection '';
        proxy_http_version 1.1;
    }
}
